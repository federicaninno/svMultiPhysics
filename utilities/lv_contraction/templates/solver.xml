<?xml version="1.0" encoding="UTF-8" ?>
<!-- Left ventricle contraction coupled to an open-loop 0D circulation.
     Generated by prepare_case.py from templates/solver.xml: edit the template
     or the case config, not this file.
     Units: m, ms, kg; pressure and stress in MPa. -->
<svMultiPhysicsFile version="0.1">

<GeneralSimulationParameters>
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> ${n_time_steps} </Number_of_time_steps>
  <Time_step_size> ${time_step} </Time_step_size> <!-- ms -->
  <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> ${save_increment} </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 0 </Start_saving_after_time_step>
  <Save_results_in_folder> results </Save_results_in_folder>

  <Increment_in_saving_restart_files> ${restart_increment} </Increment_in_saving_restart_files>
  <Convert_BIN_to_VTK_format> 0 </Convert_BIN_to_VTK_format>

  <Verbose> 1 </Verbose>
  <Warning> 1 </Warning>
  <Debug> 0 </Debug>
</GeneralSimulationParameters>

<Add_mesh name="msh" >
  <Mesh_file_path> mesh/mesh-complete.mesh.vtu </Mesh_file_path>

  <Add_face name="endo">
    <Face_file_path> mesh/mesh-surfaces/endo.${surface_ext} </Face_file_path>
  </Add_face>

  <Add_face name="epi">
    <Face_file_path> mesh/mesh-surfaces/epi.${surface_ext} </Face_file_path>
  </Add_face>

  <Add_face name="base">
    <Face_file_path> mesh/mesh-surfaces/base.${surface_ext} </Face_file_path>
  </Add_face>

  <!-- Fiber first, then sheet (HolzapfelOgden uses this order) -->
  <Fiber_direction_from_file_cells> mesh/fibers/fiber.vtu </Fiber_direction_from_file_cells>
  <Fiber_direction_from_file_cells> mesh/fibers/sheet.vtu </Fiber_direction_from_file_cells>

${prestress_line}

${domain_line}

  <Mesh_scale_factor> ${mesh_scale_factor} </Mesh_scale_factor> <!-- to m -->
</Add_mesh>

<Add_equation type="struct" >
  <Coupled> true </Coupled>
  <Min_iterations> 1 </Min_iterations>
  <Max_iterations> 30 </Max_iterations>
  <Tolerance> 1e-8 </Tolerance>

  <Line_search_experimental>
    <Minimum_decrease> 1e-4 </Minimum_decrease>
    <Step_reduction_factor> 0.5 </Step_reduction_factor>
    <Minimum_step_length> 1e-2 </Minimum_step_length>
    <Verbose> false </Verbose>
  </Line_search_experimental>

  <!-- Material (Holzapfel-Ogden, volumetric penalty) and active tension, from
       the case config; one Domain block per material with an infarct -->
${materials}

  <Output type="Spatial" >
    <Displacement> true </Displacement>
    <Velocity> true </Velocity>
    <Jacobian> true </Jacobian>
    <Cauchy_stress> true </Cauchy_stress>
    <Fiber_direction> true </Fiber_direction>
    <Fiber_stretch> true </Fiber_stretch>
  </Output>

  <LS type="GMRES" >
${linear_algebra}
    <!-- Relative tolerance: Newton does not need exact linear solves -->
    <Tolerance> ${linear_solver_tolerance} </Tolerance>
    <!-- Residuals are small in absolute terms in these units (m, MPa) -->
    <Absolute_tolerance> 1e-15 </Absolute_tolerance>
    <Max_iterations> 1000 </Max_iterations>
    <Krylov_space_dimension> 100 </Krylov_space_dimension>
  </LS>

  <svZeroDSolver_interface>
    <Coupling_type> implicit </Coupling_type>
    <Configuration_file> svzerod_3Dcoupling.json </Configuration_file>
    <Shared_library> ${svzerod_library} </Shared_library>
    <Initial_flows> 0.0 </Initial_flows>
    <Initial_pressures> ${end_diastolic_pressure} </Initial_pressures> <!-- MPa -->
    <Finite_difference_absolute_perturbation> 1e-14 </Finite_difference_absolute_perturbation>
    <Finite_difference_relative_perturbation> 1e-10 </Finite_difference_relative_perturbation>
  </svZeroDSolver_interface>

  <!-- Pericardium: normal spring and damper on the epicardium -->
  <Add_BC name="epi" >
    <Type> Robin </Type>
${epi_spring}
    <Apply_along_normal_direction> 1 </Apply_along_normal_direction>
  </Add_BC>

  <!-- Weak spring and damper on the base, in all directions -->
  <Add_BC name="base" >
    <Type> Robin </Type>
    <Stiffness> ${base_stiffness} </Stiffness> <!-- MPa/m -->
    <Damping> ${base_damping} </Damping> <!-- MPa*ms/m -->
  </Add_BC>

  <!-- Cavity pressure from the 0D model; the cap closes the cavity at the base -->
  <Add_BC name="endo" >
    <Type> Neu </Type>
    <Time_dependence> Coupled </Time_dependence>
    <Follower_pressure_load> true </Follower_pressure_load>
    <Coupling_interface>
      <svZeroDSolver_block> LV_IN </svZeroDSolver_block>
      <Chamber_cap_surface> mesh/mesh-surfaces/endo_cap.vtp </Chamber_cap_surface>
      <Relax_factor> 1.0 </Relax_factor>
    </Coupling_interface>
  </Add_BC>
</Add_equation>

</svMultiPhysicsFile>
