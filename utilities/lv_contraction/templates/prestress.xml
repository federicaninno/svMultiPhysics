<?xml version="1.0" encoding="UTF-8" ?>
<!-- Prestress of the left ventricle at end-diastole.
     Generated by prepare_case.py from templates/prestress.xml: edit the template
     or the case config, not this file.
     The end-diastolic pressure is applied on the endocardium. At every time
     step the solver adds the computed stress to the prestress and resets the
     displacement to zero, until the prestress alone balances the pressure in
     the mesh (image) geometry. extract_prestress.py then checks the
     convergence and writes mesh/prestress.vtu for solver.xml.
     Units: m, ms, kg; pressure and stress in MPa. -->
<svMultiPhysicsFile version="0.1">

<GeneralSimulationParameters>
  <Continue_previous_simulation> 0 </Continue_previous_simulation>
  <Number_of_spatial_dimensions> 3 </Number_of_spatial_dimensions>
  <Number_of_time_steps> ${n_time_steps} </Number_of_time_steps>
  <!-- Pseudo-time step: large enough that each step gets close to the static response -->
  <Time_step_size> ${prestress_time_step} </Time_step_size> <!-- ms -->
  <Spectral_radius_of_infinite_time_step> 0.50 </Spectral_radius_of_infinite_time_step>
  <Searched_file_name_to_trigger_stop> STOP_SIM </Searched_file_name_to_trigger_stop>

  <Save_results_to_VTK_format> 1 </Save_results_to_VTK_format>
  <Name_prefix_of_saved_VTK_files> result </Name_prefix_of_saved_VTK_files>
  <Increment_in_saving_VTK_files> 1 </Increment_in_saving_VTK_files>
  <Start_saving_after_time_step> 1 </Start_saving_after_time_step>
  <Save_results_in_folder> prestress </Save_results_in_folder>

  <Increment_in_saving_restart_files> ${n_time_steps} </Increment_in_saving_restart_files>
  <Convert_BIN_to_VTK_format> 0 </Convert_BIN_to_VTK_format>

  <Verbose> 1 </Verbose>
  <Warning> 1 </Warning>
  <Debug> 0 </Debug>
</GeneralSimulationParameters>

<Add_mesh name="msh" >
  <Mesh_file_path> mesh/mesh-complete.mesh.vtu </Mesh_file_path>

  <Add_face name="endo">
    <Face_file_path> mesh/mesh-surfaces/endo.${surface_ext} </Face_file_path>
  </Add_face>

  <Add_face name="epi">
    <Face_file_path> mesh/mesh-surfaces/epi.${surface_ext} </Face_file_path>
  </Add_face>

  <Add_face name="base">
    <Face_file_path> mesh/mesh-surfaces/base.${surface_ext} </Face_file_path>
  </Add_face>

  <!-- Fiber first, then sheet (HolzapfelOgden uses this order) -->
  <Fiber_direction_from_file_cells> mesh/fibers/fiber.vtu </Fiber_direction_from_file_cells>
  <Fiber_direction_from_file_cells> mesh/fibers/sheet.vtu </Fiber_direction_from_file_cells>

${domain_line}

  <Mesh_scale_factor> ${mesh_scale_factor} </Mesh_scale_factor> <!-- to m -->
</Add_mesh>

<Add_equation type="struct" >
  <Prestress> true </Prestress>
  <Coupled> true </Coupled>
  <Min_iterations> 1 </Min_iterations>
  <Max_iterations> 30 </Max_iterations>
  <Tolerance> 1e-8 </Tolerance>

  <!-- Material from the case config (one Domain block per material with an
       infarct). Density 0: quasi-static, no inertia, so that each step gets
       close to the static response. The viscosity is needed for the
       conditioning of the linear system (the shear stiffness at zero strain
       is tiny compared with the volumetric penalty); it does not affect the
       converged prestress, where the velocity vanishes. With fsils, a smaller
       viscosity (or a larger time step) makes the linear solver fail. -->
${materials}

  <Output type="Spatial" >
    <Displacement> true </Displacement>
    <Stress> true </Stress>
    <Cauchy_stress> true </Cauchy_stress>
  </Output>

  <LS type="GMRES" >
    <Linear_algebra type="fsils" >
      <Preconditioner> fsils </Preconditioner>
    </Linear_algebra>
    <Tolerance> 1e-10 </Tolerance>
    <!-- Residuals are small in absolute terms in these units (m, MPa) -->
    <Absolute_tolerance> 1e-15 </Absolute_tolerance>
    <Max_iterations> 1000 </Max_iterations>
    <Krylov_space_dimension> 100 </Krylov_space_dimension>
  </LS>

  <!-- Same springs and dampers as in solver.xml; they carry no load once the displacement vanishes -->
  <Add_BC name="epi" >
    <Type> Robin </Type>
${epi_spring}
    <Apply_along_normal_direction> 1 </Apply_along_normal_direction>
  </Add_BC>

  <Add_BC name="base" >
    <Type> Robin </Type>
    <Stiffness> ${base_stiffness} </Stiffness> <!-- MPa/m -->
    <Damping> ${base_damping} </Damping> <!-- MPa*ms/m -->
  </Add_BC>

  <!-- End-diastolic pressure on the endocardium -->
  <Add_BC name="endo" >
    <Type> Neu </Type>
    <Time_dependence> Steady </Time_dependence>
    <Value> ${end_diastolic_pressure} </Value> <!-- MPa -->
    <Follower_pressure_load> true </Follower_pressure_load>
  </Add_BC>
</Add_equation>

</svMultiPhysicsFile>
